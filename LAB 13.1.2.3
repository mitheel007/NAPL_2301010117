fun main() {
    print("Enter an integer: ")
    var num = kotlin.math.abs(readLine()!!.toInt())

    var sum = 0
    var count = 0

    if (num == 0) {
        count = 1
    }

    while (num > 0) {
        val digit = num % 10
        sum += digit
        count++
        num /= 10
    }

    val average = sum.toDouble() / count

    println("Sum of digits: $sum")
    println("Average of digits: $average")
}
------------------------------------------------------------------------------------------------------------------


class Student(
    private var rollNo: Int,
    private var name: String,
    private var course: String,
    private var percentage: Double
) {

    // Function to accept/update student data
    fun acceptData() {
        print("Enter Roll Number: ")
        rollNo = readLine()!!.toInt()

        print("Enter Name: ")
        name = readLine()!!

        print("Enter Course: ")
        course = readLine()!!

        print("Enter Percentage: ")
        percentage = readLine()!!.toDouble()
    }

    // Function to display student details
    fun displayData() {
        println("\n----- Student Details -----")
        println("Roll Number: $rollNo")
        println("Name: $name")
        println("Course: $course")
        println("Percentage: $percentage%")
    }
}

fun main() {

    // Creating first Student object
    val s1 = Student(0, "", "", 0.0)
    println("Enter details of Student 1:")
    s1.acceptData()
    s1.displayData()

    // Creating second Student object
    val s2 = Student(0, "", "", 0.0)
    println("\nEnter details of Student 2:")
    s2.acceptData()
    s2.displayData()
}

