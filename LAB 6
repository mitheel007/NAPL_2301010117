open System
open System.Text.RegularExpressions

// (1) Reverse a string and check palindrome
let reverseString (s: string) =
    new string(Array.rev (s.ToCharArray()))

let isPalindrome (s: string) =
    s = reverseString s

// (2) Transform string based on its content
let transformString (s: string) =
    if s |> Seq.forall Char.IsLetter && s <> "" then
        s.ToUpper()
    elif s <> "" && s |> Seq.forall Char.IsDigit then
        s + s
    else
        s

// (3) Validate email using Regex
let isValidEmail (email: string) =
    Regex.IsMatch(email, @"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")

// Test 1: Palindrome
printfn "Palindrome Tests:"
["madam"; "hello"; "level"]
|> List.iter (fun s ->
    printfn "%s -> Reverse: %s, Palindrome: %b"
        s (reverseString s) (isPalindrome s))

// Test 2: String Transformation
printfn "\nTransformation Tests:"
["hello"; "1234"; "abc123"]
|> List.iter (fun s ->
    printfn "%s -> %s" s (transformString s))

// Test 3: Email Validation
printfn "\nEmail Validation Tests:"
["abc@gmail.com"; "user@yahoo.in"; "invalid-email"]
|> List.iter (fun email ->
    printfn "%s -> %b" email (isValidEmail email))







