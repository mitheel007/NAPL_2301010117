//Aim: To install and configure the Go toolchain and write introductory programs that use data types, variables, and control structures to perform validated, input-driven computations. 

Tools / Environment: Go (latest stable release), VS Code with the Go extension, terminal (go run / go build), gofmt. 



open System

// Task 1
let task1 =
    async {
        printfn "Task 1 started"
        do! Async.Sleep(3000)
        printfn "Task 1 completed"
        return "Result from Task 1"
    }

// Task 2
let task2 =
    async {
        printfn "Task 2 started"
        do! Async.Sleep(2000)
        printfn "Task 2 completed"
        return "Result from Task 2"
    }

// Task 3
let task3 =
    async {
        printfn "Task 3 started"
        do! Async.Sleep(1000)
        printfn "Task 3 completed"
        return "Result from Task 3"
    }

// Execute all tasks concurrently
let tasks = [| task1; task2; task3 |]

let results = 
    tasks
    |> Async.Parallel
    |> Async.RunSynchronously

// Print all results
printfn "\nAll tasks completed. Results:"
results |> Array.iter (printfn "%s")
